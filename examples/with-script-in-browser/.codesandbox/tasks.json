{
  "setupTasks": [
    {
      "name": "Install Dependencies",
      "command": "yarn install"
    }
  ],
  "tasks": {
    "build": {
      "name": "Build",
      "command": "yarn build",
      "runAtStart": false
    },
    "start": {
      "name": "Start Example",
      "command": "yarn start",
      "runAtStart": true,
      "preview": {
        "port": 3001
      }
    },
    "install-deps": {
      "name": "Install Dependencies",
      "command": "yarn install",
      "restartOn": {
        "files": ["yarn.lock"],
        "branch": false,
        "resume": false
      }
    }
  }
}
