# ============================================================================
# Drawink Browser Environment Configuration Template
# ============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your public browser configuration in .env.local
# 3. .env.local is gitignored and should never be committed
#
# Only VITE_* variables are exposed to browser code. Convex/Clerk/AI provider
# secrets must be configured in their deployment environment, not in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# ----------------------------------------------------------------------------
# Get these from: https://dashboard.clerk.com
# Frontend (public key - safe to expose in browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# CONVEX BACKEND
# ----------------------------------------------------------------------------
# Auto-generated when you run: npx convex dev
# Dashboard: https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# ----------------------------------------------------------------------------
# FIREBASE STORAGE (Files only - database is in Convex)
# ----------------------------------------------------------------------------
# Get from: Firebase Console > Project Settings > Your apps > Web app
# JSON format required
VITE_APP_FIREBASE_CONFIG='{"apiKey":"","projectId":"","storageBucket":""}'

# ----------------------------------------------------------------------------
# COLLABORATION SERVER
# ----------------------------------------------------------------------------
# WebSocket server for real-time collaboration
# Dev: http://localhost:3003 | Prod: https://collab.drawink.app
VITE_APP_WS_SERVER_URL=http://localhost:3003

# ----------------------------------------------------------------------------
# CONVEX SERVER ENVIRONMENT (DO NOT ADD VALUES TO THIS FILE)
# ----------------------------------------------------------------------------
# Set these interactively with `npx convex env set NAME` (and `--prod` for prod):
# - CLERK_FRONTEND_API_URL
# - CLERK_WEBHOOK_SECRET
# - AI_BASE_URL
# - AI_API_KEY
# - AI_MODEL
# Optional: BETA_ENABLED
#
# Stripe billing is not implemented on the current branch. Do not add Stripe
# secrets until a verified server-side webhook/checkout integration exists.

# ----------------------------------------------------------------------------
# APP FLAGS
# ----------------------------------------------------------------------------
VITE_APP_GIT_SHA=development
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_PREVENT_UNLOAD=true
VITE_APP_DISABLE_PWA=true
VITE_APP_DISABLE_SENTRY=true
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false

# ----------------------------------------------------------------------------
# SENTRY ERROR TRACKING (Optional)
# ----------------------------------------------------------------------------
# Get from: https://sentry.io
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# OPTIONAL EXTERNAL INTEGRATIONS
# ----------------------------------------------------------------------------
# VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
# VITE_APP_LIBRARY_BACKEND=https://example.com/library-api
# VITE_APP_PLUS_APP=https://plus.drawink.app
# VITE_APP_PLUS_LP=https://plus.drawink.app
# VITE_APP_PLUS_EXPORT_PUBLIC_KEY=

# Legacy public-share backend fallback (Convex is preferred):
# VITE_APP_BACKEND_V2_GET_URL=https://example.com/api/v2/
# VITE_APP_BACKEND_V2_POST_URL=https://example.com/api/v2/post
